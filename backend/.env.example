# ==========================================
# FuelPass Backend Environment Configuration
# ==========================================

# Server Port (Cloud providers like Render/Heroku inject PORT automatically)
PORT=5050
NODE_ENV=production

# Database Connection (MySQL / TiDB / Aiven / PlanetScale)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fuelpass
# Set DB_SSL=true for cloud-hosted databases (Aiven, TiDB, PlanetScale, AWS RDS)
DB_SSL=false
DB_CONNECTION_LIMIT=10

# Security & JWT Token Signing (Use a 32+ char strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
QR_SECRET=your_super_secret_qr_signing_key_2026

# Administrator Default Credentials (Optional override)
ADMIN_USER=admin
ADMIN_PASS=admin123

# SMTP Email Dispatch (Gmail App Password or SendGrid / Mailgun SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password

# Allowed Frontend Origins for CORS (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,https://yourdomain.com
